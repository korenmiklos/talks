# Optional Langfuse tracing. When configured, the demo sends raw local input and
# dehydrated provider traffic so the privacy boundary is visible in one trace.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# OpenRouter forwarding. If set, the proxy defaults to https://openrouter.ai/api.
OPENROUTER_API_KEY=
# Optional override for another OpenAI-compatible upstream.
UPSTREAM_URL=
UPSTREAM_API_KEY=
PORT=4173
